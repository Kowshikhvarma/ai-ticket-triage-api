# Copy to .env and fill in. Everything is optional: with no OpenAI key the API uses the rule-based engine.

# LLM triage (any OpenAI-compatible endpoint works)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Chat or Slack incoming webhook for high/medium priority alerts
CHAT_WEBHOOK_URL=

# Database (SQLite default; e.g. postgresql+psycopg://user:pass@localhost/triage)
DATABASE_URL=sqlite:///./tickets.db

# Protect the API with a shared key sent in the X-API-Key header
TRIAGE_API_KEY=
